<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- One calibration run: an admin-uploaded list of "relevant" search terms, sampled against the
         live raw text-relevance score (BEFORE any function_score wrapper) to suggest a
         relevanceSaturationPoint (k) value — the pooled mean of the top relevantProductCount (X) hits'
         scores across every search term. status is one of the SearchRankingOptimizerConfig::CALIBRATION_STATUS_*
         constants; the score*/sampleCount/computedK/calculatedAt fields are null until status=calculated,
         errorMessage is set only on status=failed. -->
    <transfer name="SearchRankingCalibration" strict="true">
        <property name="idSearchRankingCalibration" type="int"/>
        <property name="relevantProductCount" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="status" type="string"/>
        <property name="computedK" type="float"/>
        <property name="scoreMin" type="float"/>
        <property name="scoreMax" type="float"/>
        <property name="scoreMean" type="float"/>
        <property name="scoreMedian" type="float"/>
        <property name="scoreP25" type="float"/>
        <property name="scoreP75" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="calculatedAt" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="totalCount" type="int"/>
        <property name="processedCount" type="int"/>
        <property name="searchTerms" type="SearchRankingCalibrationSearchTerm[]" singular="searchTerm"/>
    </transfer>

    <!-- One uploaded search term of a calibration run. scores is populated by the calibration cron: the
         raw text-relevance scores of the top-ranked products found for this term, up to the run's
         relevantProductCount — fewer when the term matched fewer products. Null until calculated. -->
    <transfer name="SearchRankingCalibrationSearchTerm" strict="true">
        <property name="idSearchRankingCalibrationSearchTerm" type="int"/>
        <property name="fkSearchRankingCalibration" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="productsFound" type="int"/>
        <property name="scores" type="float[]" singular="score"/>
    </transfer>

    <!-- A canonical search query (trim/lowercase/collapse-whitespace, NOT tokenized) that has accumulated
         at least one relevance rating. importanceWeight is Query Curator-editable, flat-defaults to 1. -->
    <transfer name="SearchRankingQuery" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="importanceWeight" type="float"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <!-- One Relevance Rater's judgment for a (query, product) pair. Unique per (fkSearchRankingQuery,
         customerReference, fkProductAbstract) — the same rater re-clicking the same pair upserts in place;
         different raters on the same pair each keep their own row (disagreement is a signal, never
         overwritten — see README). ratingType is one of SearchRankingOptimizerConfig::RATING_TYPE_*. -->
    <transfer name="SearchRankingQueryRating" strict="true">
        <property name="idSearchRankingQueryRating" type="int"/>
        <property name="fkSearchRankingQuery" type="int"/>
        <property name="customerReference" type="string"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="ratingType" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <!-- Yves -> Zed gateway request: submits one Relevance Rater judgment. searchTerm arrives
         UN-canonicalized (raw, as typed by the shopper who ran this search) — the Zed side canonicalizes
         it before finding-or-creating the SearchRankingQuery row, so the same logical query submitted with
         different casing/whitespace always resolves to the same row. customerReference is set server-side
         by the Yves controller from the authenticated session, never trusted from client input. -->
    <transfer name="SearchRankingProductRelevanceJudgmentRequest" strict="true">
        <property name="searchTerm" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="idProductAbstract" type="int"/>
        <property name="ratingType" type="string"/>
        <property name="customerReference" type="string"/>
    </transfer>

    <!-- Zed -> Yves gateway response. isSuccess=false covers both an unauthorized caller (isAuthorized
         check failed) and a rejected write (e.g. InvalidRatingTypeException) — errorMessage explains
         which; the Yves side never needs to distinguish them, it just leaves the widget ungrayed/unchanged
         either way. -->
    <transfer name="SearchRankingProductRelevanceJudgmentResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="rating" type="SearchRankingQueryRating"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- One rated (query, product) judgment feeding a rank_eval evaluation: the query's own id/searchTerm
         plus the per-product mean gain across every admin who rated that (query, product) pair (see
         SearchRankingEvaluationRequest for how "mean" is computed and why). -->
    <transfer name="SearchRankingEvaluationProductGain" strict="true">
        <property name="idProductAbstract" type="int"/>
        <property name="gain" type="float"/>
    </transfer>

    <!-- One query's worth of rank_eval input: its canonical searchTerm (fired as the live catalog query)
         plus every rated product's gain for it. -->
    <transfer name="SearchRankingEvaluationQuery" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="importanceWeight" type="float"/>
        <property name="productGains" type="SearchRankingEvaluationProductGain[]" singular="productGain"/>
    </transfer>

    <!-- Zed business layer -> Client bridge request: fire one _rank_eval call covering every rated query
         for a single (storeName, localeName) — mirrors Calibration's own store/locale scoping. cutoff is
         the nDCG @k cutoff (SearchRankingOptimizerConfig::getRankEvalCutoff()). -->
    <transfer name="SearchRankingEvaluationRequest" strict="true">
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="cutoff" type="int"/>
        <property name="queries" type="SearchRankingEvaluationQuery[]" singular="query"/>
    </transfer>

    <!-- One query's own nDCG@cutoff, read out of _rank_eval's response `details` map (NOT the response's
         own top-level metric_score, which is a plain unweighted mean across queries — the
         query-importance-weighted aggregate is computed in PHP from these per-query values instead; see
         RankEvaluationRunner). -->
    <transfer name="SearchRankingEvaluationQueryScore" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="metricScore" type="float"/>
    </transfer>

    <!-- Client bridge -> Zed business layer response: one score per query that was actually included in
         the request. -->
    <transfer name="SearchRankingEvaluationResponse" strict="true">
        <property name="queryScores" type="SearchRankingEvaluationQueryScore[]" singular="queryScore"/>
    </transfer>

    <!-- One persisted evaluation run: the query-importance-weighted nDCG aggregate across every rated
         query for a (storeName, localeName) at a point in time, computed in PHP from the individual
         SearchRankingEvaluationQueryScore values (see SearchRankingEvaluationResponse) weighted by each
         query's own importanceWeight. queryCount is how many queries actually had ratings to contribute -
         a run over a store/locale with zero rated queries is never persisted (nothing to evaluate). -->
    <transfer name="SearchRankingEvaluation" strict="true">
        <property name="idSearchRankingEvaluation" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="metricScore" type="float"/>
        <property name="queryCount" type="int"/>
        <property name="createdAt" type="string"/>
    </transfer>

</transfers>
