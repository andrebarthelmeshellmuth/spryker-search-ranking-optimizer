<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- One calibration run: an admin-uploaded list of "relevant" search terms, sampled to suggest either
         relevanceSaturationPoint or specificitySaturationPoint (k), depending on calibrationType
         (SearchRankingOptimizerConfig::CALIBRATION_TYPE_*) — the pooled mean of the top relevantProductCount
         (X) hits' raw values across every search term for CALIBRATION_TYPE_RELEVANCE_SCORE (BEFORE any
         function_score wrapper), or the pooled mean of one raw specificity value per search term (no real
         catalog query at all) for CALIBRATION_TYPE_SPECIFICITY. status is one of the
         SearchRankingOptimizerConfig::CALIBRATION_STATUS_* constants; the value*/sampleCount/computedK/
         calculatedAt fields are null until status=calculated, errorMessage is set only on status=failed. -->
    <transfer name="SearchRankingSaturationPointCalibration" strict="true">
        <property name="idSearchRankingSaturationPointCalibration" type="int"/>
        <property name="calibrationType" type="string"/>
        <property name="relevantProductCount" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="status" type="string"/>
        <property name="computedK" type="float"/>
        <property name="valueMin" type="float"/>
        <property name="valueMax" type="float"/>
        <property name="valueMean" type="float"/>
        <property name="valueMedian" type="float"/>
        <property name="valueP25" type="float"/>
        <property name="valueP75" type="float"/>
        <property name="sampleCount" type="int"/>
        <property name="calculatedAt" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="totalCount" type="int"/>
        <property name="processedCount" type="int"/>
        <property name="searchTerms" type="SearchRankingSaturationPointCalibrationSearchTerm[]" singular="searchTerm"/>
    </transfer>

    <!-- One uploaded search term of a calibration run. values is populated by the calibration cron: for
         CALIBRATION_TYPE_RELEVANCE_SCORE, the raw text-relevance scores of the top-ranked products found
         for this term (up to the run's relevantProductCount, fewer when the term matched fewer products);
         for CALIBRATION_TYPE_SPECIFICITY, exactly one raw specificity value for the term itself (no
         per-product query at all). Null until calculated. -->
    <transfer name="SearchRankingSaturationPointCalibrationSearchTerm" strict="true">
        <property name="idSearchRankingSaturationPointCalibrationSearchTerm" type="int"/>
        <property name="fkSearchRankingSaturationPointCalibration" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="productsFound" type="int"/>
        <property name="values" type="float[]" singular="value"/>
    </transfer>

    <!-- A canonical search query (trim/lowercase/collapse-whitespace, NOT tokenized) that has accumulated
         at least one relevance rating. importanceWeight is Query Curator-editable, flat-defaults to 1. -->
    <transfer name="SearchRankingQuery" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="importanceWeight" type="float"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <!-- One Relevance Rater's judgment for a (query, product) pair. Unique per (fkSearchRankingQuery,
         customerReference, fkProductAbstract) — the same rater re-clicking the same pair upserts in place;
         different raters on the same pair each keep their own row (disagreement is a signal, never
         overwritten — see README). ratingType is one of SearchRankingOptimizerConfig::RATING_TYPE_*. -->
    <transfer name="SearchRankingQueryRating" strict="true">
        <property name="idSearchRankingQueryRating" type="int"/>
        <property name="fkSearchRankingQuery" type="int"/>
        <property name="customerReference" type="string"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="ratingType" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <!-- Yves -> Zed gateway request: submits one Relevance Rater judgment. searchTerm arrives
         UN-canonicalized (raw, as typed by the shopper who ran this search) — the Zed side canonicalizes
         it before finding-or-creating the SearchRankingQuery row, so the same logical query submitted with
         different casing/whitespace always resolves to the same row. customerReference is set server-side
         by the Yves controller from the authenticated session, never trusted from client input. -->
    <transfer name="SearchRankingProductRelevanceJudgmentRequest" strict="true">
        <property name="searchTerm" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="idProductAbstract" type="int"/>
        <property name="ratingType" type="string"/>
        <property name="customerReference" type="string"/>
    </transfer>

    <!-- Zed -> Yves gateway response. isSuccess=false covers both an unauthorized caller (isAuthorized
         check failed) and a rejected write (e.g. InvalidRatingTypeException) — errorMessage explains
         which; the Yves side never needs to distinguish them, it just leaves the widget ungrayed/unchanged
         either way. -->
    <transfer name="SearchRankingProductRelevanceJudgmentResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="rating" type="SearchRankingQueryRating"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Yves -> Zed gateway request: the SRP widget's own batched "what did I already rate on this page"
         read, fired once per page render (not once per product tile) covering every product currently on
         the page. searchTerm arrives UN-canonicalized, same reasoning as SearchRankingProductRelevanceJudgmentRequest.
         customerReference is set server-side by the Yves controller from the authenticated session, never
         trusted from client input. -->
    <transfer name="SearchRankingProductRelevanceJudgmentBatchRequest" strict="true">
        <property name="searchTerm" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="idProductAbstracts" type="int[]" singular="idProductAbstract"/>
        <property name="customerReference" type="string"/>
    </transfer>

    <!-- Zed -> Yves gateway response. isSuccess=false covers only an unauthorized caller here - unlike
         SearchRankingProductRelevanceJudgmentResponse there is no rejected-write case to report, this is a
         read. An empty ratings array on isSuccess=true is the ordinary/expected result for a query nobody
         (or not this customer) has rated yet, never an error. -->
    <transfer name="SearchRankingProductRelevanceJudgmentBatchResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="ratings" type="SearchRankingQueryRating[]" singular="rating"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- One rated (query, product) judgment feeding a rank_eval evaluation: the query's own id/searchTerm
         plus the per-product mean gain across every admin who rated that (query, product) pair (see
         SearchRankingEvaluationRequest for how "mean" is computed and why). -->
    <transfer name="SearchRankingEvaluationProductGain" strict="true">
        <property name="idProductAbstract" type="int"/>
        <property name="gain" type="float"/>
    </transfer>

    <!-- One query's worth of rank_eval input: its canonical searchTerm (fired as the live catalog query)
         plus every rated product's gain for it. -->
    <transfer name="SearchRankingEvaluationQuery" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="searchTerm" type="string"/>
        <property name="importanceWeight" type="float"/>
        <property name="productGains" type="SearchRankingEvaluationProductGain[]" singular="productGain"/>
    </transfer>

    <!-- Zed business layer -> Client bridge request: fire one _rank_eval call covering every rated query
         for a single (storeName, localeName) — mirrors Saturation Point Calibration's own store/locale scoping. cutoff is
         the nDCG @k cutoff (SearchRankingOptimizerConfig::getRankEvalCutoff()). rankingConfiguration is
         OPTIONAL: when null, RankEvalRunner fetches the LIVE synced search-ranking configuration (the
         normal Evaluation-page path — "how good is our currently-configured ranking formula, really?").
         When set, RankEvalRunner uses THIS configuration instead of the live one — never touching synced
         storage — so a candidate weight vector can be scored without ever being applied. This is the exact
         extension point Phase O6's optimizer needs to evaluate proposals it hasn't (and might never) apply. -->
    <transfer name="SearchRankingEvaluationRequest" strict="true">
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="cutoff" type="int"/>
        <property name="queries" type="SearchRankingEvaluationQuery[]" singular="query"/>
        <property name="rankingConfiguration" type="SearchRankingConfigurationStorage"/>
    </transfer>

    <!-- One query's own nDCG@cutoff, read out of _rank_eval's response `details` map (NOT the response's
         own top-level metric_score, which is a plain unweighted mean across queries — the
         query-importance-weighted aggregate is computed in PHP from these per-query values instead; see
         RankEvaluationRunner). -->
    <transfer name="SearchRankingEvaluationQueryScore" strict="true">
        <property name="idSearchRankingQuery" type="int"/>
        <property name="metricScore" type="float"/>
    </transfer>

    <!-- Client bridge -> Zed business layer response: one score per query that was actually included in
         the request. -->
    <transfer name="SearchRankingEvaluationResponse" strict="true">
        <property name="queryScores" type="SearchRankingEvaluationQueryScore[]" singular="queryScore"/>
    </transfer>

    <!-- One persisted evaluation run: the query-importance-weighted nDCG aggregate across every rated
         query for a (storeName, localeName) at a point in time, computed in PHP from the individual
         SearchRankingEvaluationQueryScore values (see SearchRankingEvaluationResponse) weighted by each
         query's own importanceWeight. queryCount is how many queries actually had ratings to contribute -
         a run over a store/locale with zero rated queries is never persisted (nothing to evaluate). -->
    <transfer name="SearchRankingEvaluation" strict="true">
        <property name="idSearchRankingEvaluation" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="metricScore" type="float"/>
        <property name="queryCount" type="int"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- One metric's weight at the moment a checkpoint was taken. idSearchRankingMetric is
         search-ranking's own metric id, kept only as a best-effort restore key, since that metric could
         be deleted before a restore attempt (see WeightCheckpointRestorer, a safe no-op in that case). -->
    <!-- isLocaleScoped mirrors search-ranking's own per-metric flag AT RECORD TIME: a store-wide metric
         (isLocaleScoped=false) is the one whose weight search-ranking's own saveMetricWeight() fans out
         to every real locale of the store on write. Recorded here so a checkpoint restore can warn which
         other locales it's about to touch, not just this one (see WeightCheckpointRestorer). Left unset
         (null) on the SearchRankingOptimizerRun::bestMetricWeights reuse of this same shape: a run
         proposes a value for a store-wide metric like any other, but the blast-radius disclosure there is
         resolved on demand via resolveEffectiveWeightLocales() instead of carried on this field (see
         AutomatedWeightOptimizationController). -->
    <transfer name="SearchRankingWeightCheckpointMetricWeight" strict="true">
        <property name="idSearchRankingMetric" type="int"/>
        <property name="name" type="string"/>
        <property name="weight" type="float"/>
        <property name="isLocaleScoped" type="bool"/>
    </transfer>

    <!-- A full point-in-time snapshot of what the propose/review/apply workflow needs to
         reproduce: the relevanceWeight blend, every metric's own weight, and the 4 specificity-weighting
         knobs (blend weight/curve exponent/exponent/shift magnitude) — NOT relevanceSaturationPoint/specificitySaturationPoint,
         which already have their own versioning story via Saturation Point Calibration and stay out of checkpoint scope
         deliberately. The specificity knobs ARE included: they directly shape the live ranking formula's
         behavior the same way relevanceWeight/metric weights do, so a checkpoint that omitted them
         wouldn't actually reproduce a past ranking behavior, only part of it. isSpecificityWeightingEnabled
         is captured alongside them — specificity weighting is a code-level, project-wide flag
         (search-ranking's SearchRankingConfig::isSpecificityWeightingEnabled()) independent of the 4 knob
         VALUES, so a checkpoint honestly records whether those numbers were actually live at the time,
         rather than silently implying they always were. source is 'manual' for now (a Query
         Curator-triggered "take checkpoint now" or a restore); a later automated-weight-search phase will
         add an 'algorithm' value as that producer gets built, per the "one harness, N producers" design.
         The monthly auto-tune job (see SearchRankingAutoTuneResult below) is NOT a producer here — it
         refits a metric's FORMULA (curve shape/parameter), never relevanceWeight/metric weight/specificity
         knobs, so it has no reason to write a weight checkpoint at all; its own before/after audit trail
         lives entirely in spryker-community/search-ranking's own metric-history table instead. -->
    <transfer name="SearchRankingWeightCheckpoint" strict="true">
        <property name="idSearchRankingWeightCheckpoint" type="int"/>
        <property name="source" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="relevanceWeight" type="float"/>
        <property name="specificityBlendWeight" type="float"/>
        <property name="specificityCurveExponent" type="float"/>
        <property name="specificityWeightExponent" type="float"/>
        <property name="specificityWeightShiftMagnitude" type="float"/>
        <property name="isSpecificityWeightingEnabled" type="bool"/>
        <property name="metricWeights" type="SearchRankingWeightCheckpointMetricWeight[]" singular="metricWeight"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- Per-metric monthly auto-tune settings, owned entirely by THIS package (search-ranking's own
         metric row carries no such fields — the auto-tune JOB and everything it needs to decide lives
         here, never in the base package, so a base-only install ships no inert auto-tune toggle that
         nothing reads). idSearchRankingMetric is a soft reference to search-ranking's own metric id, no
         hard foreign key (same discipline as SearchRankingWeightCheckpointMetricWeight above) — the
         metric could be deleted between config edits and a later run, handled as a safe skip, not an
         error. autoTuneThreshold is the R² floor below which the metric is flagged as needing attention;
         NULL opts the metric out of auto-tune entirely (the default: nothing runs against a metric until
         an admin explicitly sets a threshold). isAutoUpdateEnabled/autoUpdateScope only matter once a
         threshold IS crossed - see AUTO_UPDATE_SCOPE_* on SearchRankingOptimizerConfig for what scope
         means. isNotifyEnabled controls the before/after summary email, independently of isAutoUpdateEnabled
         (all 4 on/off combinations of the two are valid and meaningful - see the package README). -->
    <transfer name="SearchRankingAutoTuneMetricConfig" strict="true">
        <property name="idSearchRankingAutoTuneMetricConfig" type="int"/>
        <property name="idSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="autoTuneThreshold" type="float"/>
        <property name="isAutoUpdateEnabled" type="bool"/>
        <property name="autoUpdateScope" type="string"/>
        <property name="isNotifyEnabled" type="bool"/>
    </transfer>

    <!-- One metric processed by a single auto-tune run, at one (storeName, localeName). For a store-wide
         metric (search-ranking's own isLocaleScoped=false, the common case) there is exactly one of these
         per (metric, store), always at that store's own default locale - a refit/apply fans out to every
         real locale of the store on search-ranking's own side regardless. For a genuinely locale-scoped
         metric (isLocaleScoped=true) there is one of these per (metric, store, REAL locale) instead - each
         checked/refit/applied fully independently, since a save for one locale never touches another.

         wasThresholdMet=true means the live formula's fit was already at or above autoTuneThreshold -
         nothing else on this transfer is meaningful (no refit was computed, since none was needed).
         wasThresholdMet=false + wasSkippedNonDeterministic=true means the fit dropped below threshold but
         the metric's own formula calls a non-deterministic function (e.g. random()) - still checked and
         visible, but no refit was ever computed, since fitting a "better" curve to noise would just
         overfit to whatever randomness happened to be in that digest snapshot. wasThresholdMet=false +
         wasSkippedNonDeterministic=false means a refit WAS computed (afterFormula/afterFitRSquared/
         afterShape always set in that case, regardless of whether it was actually applied); wasApplied
         reflects whether isAutoUpdateEnabled caused it to be persisted through search-ranking's own
         facade, or it was only proposed (logged/emailed, formula left untouched). errorMessage is set
         instead of everything above when processing this ONE (metric, locale) raised an unexpected
         exception (e.g. search-ranking's facade/ES call failed) — AutoTuneRunner catches per-(metric,
         locale) so one broken one can never abort the whole run; every other metric/locale with a
         threshold set still gets checked, and this entry surfaces the failure rather than swallowing it. -->
    <transfer name="SearchRankingAutoTuneMetricResult" strict="true">
        <property name="idSearchRankingMetric" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="metricName" type="string"/>
        <property name="wasThresholdMet" type="bool"/>
        <property name="wasSkippedNonDeterministic" type="bool"/>
        <property name="beforeFormula" type="string"/>
        <property name="beforeFitRSquared" type="float"/>
        <property name="fitRSquaredByLocale" type="array" singular="fitRSquared" associative="true"/>
        <property name="afterFormula" type="string"/>
        <property name="afterShape" type="string"/>
        <property name="afterFitRSquared" type="float"/>
        <property name="wasApplied" type="bool"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <!-- Full result of one auto-tune run, across every metric that has a SearchRankingAutoTuneMetricConfig
         row with autoTuneThreshold set (metrics with no config, or a NULL threshold, are simply absent
         from metricResults - opted out). notifiedEmailCount is the number of admin addresses the summary
         email (if any metric needed one) was actually sent to - 0 when no metric crossed its threshold
         with notify enabled, OR when notify was needed but no admin holds
         SearchRankingOptimizerConfig::AUTO_TUNE_NOTIFICATION_ROLE_NAME yet. -->
    <transfer name="SearchRankingAutoTuneResult" strict="true">
        <property name="metricResults" type="SearchRankingAutoTuneMetricResult[]" singular="metricResult"/>
        <property name="notifiedEmailCount" type="int"/>
    </transfer>

    <!-- Why the auto-tune summary email would reach nobody, in enough detail for a diagnostic to name the
         actual remedy. Every one of the three states below makes AutoTuneRunner send to zero recipients
         WITHOUT failing the run — the reason this shape exists at all: the run reports success either way,
         and under cron nobody reads the console line that would have said so.

         isNotifyEnabledAnywhere=false means no metric has "notify by email" turned on, so none of the rest
         matters yet — the role is genuinely optional for a shop that never enabled notifications, and
         reporting a missing role as a problem there would be crying wolf. doesRoleExist=false means the
         host shop never created AUTO_TUNE_NOTIFICATION_ROLE_NAME at all. doesRoleExist=true with empty
         recipientEmails means it exists but is unstaffed — no ACL group holds it, or the groups that do
         have no users; deliberately NOT split further, since both have the same remedy (assign the role to
         a group and put users in it) and separating them would only add a state nobody acts on differently.

         recipientEmails comes from AutoTuneNotificationRecipientResolver::resolve(), the same call the real
         send path makes, never a second traversal of the ACL tables — a diagnosis that reimplemented the
         lookup could pass while the real send still reached nobody. -->
    <transfer name="SearchRankingAutoTuneNotificationDiagnosis" strict="true">
        <property name="isNotifyEnabledAnywhere" type="bool"/>
        <property name="roleName" type="string"/>
        <property name="doesRoleExist" type="bool"/>
        <property name="recipientEmails" type="string[]" singular="recipientEmail"/>
    </transfer>

    <!-- Extends spryker/mail's own core `Mail` transfer (standard Spryker transfer-merge-by-name
         mechanism) purely to carry the auto-tune summary email's own data through to its Twig template
         (Presentation/Mail/auto-tune-summary.html.twig) — the ONLY context a rendered mail template
         receives is the MailTransfer itself (see spryker/symfony-mailer's TwigRenderer), so there is no
         other way to pass this data through. Never set outside AutoTuneRunner's own email-sending path. -->
    <transfer name="Mail">
        <property name="autoTuneMetricResults" type="SearchRankingAutoTuneMetricResult[]" singular="autoTuneMetricResult"/>
        <property name="autoTuneAnyApplied" type="bool"/>
    </transfer>

    <!-- Phase O6: one automated weight-optimization run, mirroring Saturation Point Calibration's own queue-then-process
         lifecycle (status starts at 'queued', a console command picks up the oldest queued run and moves
         it through 'running' to 'done'/'failed') and its progress-counter shape (totalCount/processedCount).
         Reuses SearchRankingWeightCheckpointMetricWeight for bestMetricWeights, identical shape, no need
         for a near-duplicate transfer. Always propose-only: a 'done' run's winning candidate is never
         applied automatically, regardless of algorithm or score improvement — a human reviews it on the
         Zed page and explicitly clicks Apply, which goes through the SAME write-through-facade +
         checkpoint pipeline as any other weight change (see WeightCheckpointRestorer). -->
    <!-- fixedRelevanceWeight/fixedSpecificity*/fixedMetricWeights: a human's own parameter-selection choice
         at queue time (the Automated Weight Optimization run form's checklist) — null means that scalar was
         left free for the search, same as every run before this field existed; a non-null value means the
         human pinned it at exactly that value instead (not necessarily the value it happened to have live
         at queue time — a human can search-and-fix at a hypothetical number just as easily as the current
         one). fixedMetricWeights carries the same choice for individual metrics, reusing
         SearchRankingWeightCheckpointMetricWeight's shape/JSON encoding identically to bestMetricWeights
         (isLocaleScoped is left unset, same as bestMetricWeights already does). A metric a human did NOT
         fix can still end up held constant anyway if its own formula turns out non-deterministic (see
         FormulaDeterminismCheckerInterface) — that's OptimizationRunner's own orthogonal decision, not
         recorded here. -->
    <!-- One restart RestartingOptimizerDecorator (andrebarthelmeshellmuth/blackbox-optimizer) actually ran,
         mirroring BlackboxOptimizer\Algorithm\RestartHistoryEntry's own fields. bestScore is this restart's
         own best value NEGATED back into this package's own nDCG-is-better-when-higher convention (every
         blackbox-optimizer algorithm minimizes, so a run's own objective negates nDCG before handing it
         over — see OptimizationRunner::buildObjectiveFunction() — and this undoes that same negation for
         display, exactly like SearchRankingOptimizerRun::bestScore already does for the run as a whole).
         terminationReason is BlackboxOptimizer\Algorithm\Internal\TerminationReason's own case name
         (NONE/TOL_X/TOL_X_UP/CONDITION_COV/TOL_FUN) as a plain string, so this transfer stays free of a
         dependency on that package's enum type. -->
    <transfer name="SearchRankingOptimizerRestartHistoryEntry" strict="true">
        <property name="restartIndex" type="int"/>
        <property name="populationSize" type="int"/>
        <property name="generationsAllowed" type="int"/>
        <property name="generationsUsed" type="int"/>
        <property name="terminationReason" type="string"/>
        <property name="bestScore" type="float"/>
        <property name="evaluationsConsumed" type="int"/>
        <property name="improvedOverallBest" type="bool"/>
    </transfer>

    <transfer name="SearchRankingOptimizerRun" strict="true">
        <property name="idSearchRankingOptimizerRun" type="int"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="algorithm" type="string"/>
        <property name="isTerminationCriteriaTrusted" type="bool"/>
        <property name="isRestartOnPlateauEnabled" type="bool"/>
        <property name="warmStartFraction" type="float"/>
        <property name="fixedRelevanceWeight" type="float"/>
        <property name="fixedSpecificityCurveExponent" type="float"/>
        <property name="fixedSpecificityWeightExponent" type="float"/>
        <property name="fixedSpecificityWeightShiftMagnitude" type="float"/>
        <property name="fixedSpecificityBlendWeight" type="float"/>
        <property name="fixedMetricWeights" type="SearchRankingWeightCheckpointMetricWeight[]" singular="fixedMetricWeight"/>
        <property name="status" type="string"/>
        <property name="totalCount" type="int"/>
        <property name="processedCount" type="int"/>
        <property name="generationsUsed" type="int"/>
        <property name="restartHistory" type="SearchRankingOptimizerRestartHistoryEntry[]" singular="restartHistoryEntry"/>
        <property name="baselineScore" type="float"/>
        <property name="bestRelevanceWeight" type="float"/>
        <property name="bestMetricWeights" type="SearchRankingWeightCheckpointMetricWeight[]" singular="bestMetricWeight"/>
        <property name="bestScore" type="float"/>
        <property name="bestSpecificityBlendWeight" type="float"/>
        <property name="bestSpecificityCurveExponent" type="float"/>
        <property name="bestSpecificityWeightExponent" type="float"/>
        <property name="bestSpecificityWeightShiftMagnitude" type="float"/>
        <property name="completedAt" type="string"/>
        <property name="errorMessage" type="string"/>
        <property name="appliedAt" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
    </transfer>

    <!-- How much of the back office can actually reach this package's Zed pages, for
         `search-ranking-optimizer:check-installation` to report on. Zed access is deny-by-default outside a matching
         ACL rule, and a nav entry the current user has no rule for is filtered out of the sidebar entirely
         (see Spryker's own AclNavigationItemFilterPlugin) rather than 403ing — so "the adopter never
         adjusted ACL" looks exactly like "the package was never installed".

         The split that matters is unrestrictedRoleCount vs restrictedRoleCount. A default Spryker install
         gives root_role a total wildcard and puts every installer user in root_group, so these pages are
         reachable out of the box and nothing needs doing — that is the unrestricted count. Roles carrying
         explicit per-module rules instead are the restricted count, and they reach nothing here until
         somebody adds a rule. restrictedRoleWithAccessCount separates "the adopter pointed a restricted
         role at this feature" from "no restricted role can see it", which is the only state worth
         mentioning — and even then only as something to confirm, never as a failure: restricting these
         pages to root-style admins is a perfectly ordinary choice.

         Counts rather than names deliberately: this is a yes/no/how-many signal about the shape of an
         installation, and printing an adopter's internal role names into console output buys nothing. -->
    <transfer name="SearchRankingOptimizerBackOfficeAccessDiagnosis" strict="true">
        <property name="moduleNames" type="string[]" singular="moduleName"/>
        <property name="unrestrictedRoleCount" type="int"/>
        <property name="restrictedRoleCount" type="int"/>
        <property name="restrictedRoleWithAccessCount" type="int"/>
    </transfer>

</transfers>
