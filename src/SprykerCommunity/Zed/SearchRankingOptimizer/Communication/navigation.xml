<?xml version="1.0" encoding="UTF-8"?>
<config>
    <search-ranking-optimizer-gui>
        <label>Search Ranking Optimizer</label>
        <title>Search Ranking Optimizer</title>
        <icon>tune</icon>
        <bundle>search-ranking-optimizer</bundle>
        <controller>calibration</controller>
        <action>index</action>
        <pages>
            <search-ranking-optimizer-calibration>
                <label>Calibration</label>
                <title>Calibration</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>calibration</controller>
                <action>index</action>
            </search-ranking-optimizer-calibration>
            <search-ranking-optimizer-calibration-apply>
                <label>Apply Calibration</label>
                <title>Apply Calibration</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>calibration-apply</controller>
                <action>index</action>
                <visible>0</visible>
            </search-ranking-optimizer-calibration-apply>
            <search-ranking-optimizer-query>
                <label>Queries</label>
                <title>Rated Search Queries</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>query</controller>
                <action>index</action>
            </search-ranking-optimizer-query>
            <search-ranking-optimizer-query-edit>
                <label>Edit Query Importance</label>
                <title>Edit Query Importance</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>query</controller>
                <action>edit</action>
                <visible>0</visible>
            </search-ranking-optimizer-query-edit>
            <search-ranking-optimizer-evaluation>
                <label>Evaluation</label>
                <title>Rank Evaluation</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>evaluation</controller>
                <action>index</action>
            </search-ranking-optimizer-evaluation>
            <search-ranking-optimizer-checkpoint>
                <label>Weight Checkpoints</label>
                <title>Weight Checkpoints</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>checkpoint</controller>
                <action>index</action>
            </search-ranking-optimizer-checkpoint>
            <search-ranking-optimizer-auto-tune>
                <label>Auto-Tune Settings</label>
                <title>Auto-Tune Settings</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>auto-tune</controller>
                <action>index</action>
            </search-ranking-optimizer-auto-tune>
            <search-ranking-optimizer-optimization>
                <label>Automated Optimization</label>
                <title>Automated Weight Optimization</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>optimization</controller>
                <action>index</action>
            </search-ranking-optimizer-optimization>
            <search-ranking-optimizer-optimization-apply>
                <label>Apply Optimization</label>
                <title>Apply Optimization</title>
                <bundle>search-ranking-optimizer</bundle>
                <controller>optimization-apply</controller>
                <action>index</action>
                <visible>0</visible>
            </search-ranking-optimizer-optimization-apply>
        </pages>
    </search-ranking-optimizer-gui>
</config>
