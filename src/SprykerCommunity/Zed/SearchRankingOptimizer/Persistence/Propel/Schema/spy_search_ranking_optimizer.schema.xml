<?xml version="1.0"?>
<database xmlns="spryker:schema-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="zed" namespace="Orm\Zed\SearchRankingOptimizer\Persistence" package="src.Orm.Zed.SearchRankingOptimizer.Persistence" xsi:schemaLocation="spryker:schema-01 https://static.spryker.com/schema-01.xsd">

    <table name="spy_search_ranking_calibration" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_calibration" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="relevant_product_count" type="INTEGER" required="true" description="X: number of top-ranked products per search term assumed relevant, e.g. 6."/>
        <column name="store_name" type="VARCHAR" size="64" required="true" description="Store the calibration query runs against, e.g. DE — picked by the admin at upload time, since Zed has no implicit current store."/>
        <column name="locale_name" type="VARCHAR" size="16" required="true" description="Locale the calibration query runs against, e.g. de_DE — picked by the admin at upload time."/>
        <column name="status" type="VARCHAR" size="32" required="true" defaultValue="uploaded" description="uploaded, skipped, calculating, calculated or failed."/>
        <column name="computed_k" type="DOUBLE" required="false" description="Pooled mean text-relevance score across all sampled products; the calculated relevanceSaturationPoint suggestion."/>
        <column name="score_min" type="DOUBLE" required="false"/>
        <column name="score_max" type="DOUBLE" required="false"/>
        <column name="score_mean" type="DOUBLE" required="false"/>
        <column name="score_median" type="DOUBLE" required="false"/>
        <column name="score_p25" type="DOUBLE" required="false"/>
        <column name="score_p75" type="DOUBLE" required="false"/>
        <column name="sample_count" type="INTEGER" required="false" description="Total number of pooled product scores the stats were computed from."/>
        <column name="calculated_at" type="TIMESTAMP" required="false"/>
        <column name="error_message" type="VARCHAR" size="1024" required="false"/>
        <column name="total_count" type="INTEGER" required="true" defaultValue="0" description="Search term count, set once at upload time — the denominator for the live progress counter shown while status=calculating."/>
        <column name="processed_count" type="INTEGER" required="true" defaultValue="0" description="Search terms fired so far in the current/last run — incremented one at a time inside ScoreCalibrator::calculate()'s own per-term loop, the numerator for the live progress counter."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_calibration_pk_seq"/>

        <index name="index-spy_src-status">
            <index-column name="status"/>
        </index>
    </table>

    <table name="spy_search_ranking_calibration_search_term" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_calibration_search_term" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="fk_search_ranking_calibration" type="INTEGER" required="true"/>
        <column name="search_term" type="VARCHAR" size="255" required="true"/>
        <column name="products_found" type="INTEGER" required="false" description="Null until calculated; may be less than the run's relevant_product_count."/>
        <column name="scores" type="LONGVARCHAR" required="false" description="Comma-separated raw text-relevance scores, one per found product, null until calculated."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_calibration_search_term_pk_seq"/>

        <foreign-key name="spy_src_search_term-fk_calibration" foreignTable="spy_search_ranking_calibration" phpName="SearchRankingCalibration" refPhpName="SearchRankingCalibrationSearchTerm" onDelete="CASCADE">
            <reference local="fk_search_ranking_calibration" foreign="id_search_ranking_calibration"/>
        </foreign-key>

        <index name="index-spy_src_search_term-fk_calibration">
            <index-column name="fk_search_ranking_calibration"/>
        </index>
    </table>

    <table name="spy_search_ranking_query" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_query" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="search_term" type="VARCHAR" size="255" required="true" description="Canonical form: trimmed, lowercased, whitespace-collapsed — deliberately NOT tokenized, since real tokenization risks silently merging queries that are actually different asks."/>
        <column name="store_name" type="VARCHAR" size="64" required="true"/>
        <column name="locale_name" type="VARCHAR" size="16" required="true"/>
        <column name="importance_weight" type="FLOAT" required="true" defaultValue="1" description="Query Curator-editable (SetSearchQueryImportancePermissionPlugin). Flat default of 1 for every query until a human assigns real importance — see README."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_query_pk_seq"/>

        <unique name="unique-spy_search_ranking_query-term_store_locale">
            <unique-column name="search_term"/>
            <unique-column name="store_name"/>
            <unique-column name="locale_name"/>
        </unique>
    </table>

    <table name="spy_search_ranking_query_rating" idMethod="native" identifierQuoting="true">
        <column name="id_search_ranking_query_rating" type="INTEGER" required="true" autoIncrement="true" primaryKey="true"/>
        <column name="fk_search_ranking_query" type="INTEGER" required="true"/>
        <column name="customer_reference" type="VARCHAR" size="255" required="true" description="A unique reference for a customer — same convention as spy_product_review.customer_reference, deliberately not a real foreign key to spy_customer (loose coupling across the Client/Zed boundary, standard Spryker pattern)."/>
        <column name="fk_product_abstract" type="INTEGER" required="true"/>
        <column name="rating_type" type="VARCHAR" size="16" required="true" description="heart, check, or x — see SearchRankingOptimizerConfig::RATING_TYPE_*."/>

        <behavior name="timestampable"/>
        <id-method-parameter value="spy_search_ranking_query_rating_pk_seq"/>

        <foreign-key name="spy_srqr-fk_query" foreignTable="spy_search_ranking_query" phpName="SearchRankingQuery" refPhpName="SearchRankingQueryRating" onDelete="CASCADE">
            <reference local="fk_search_ranking_query" foreign="id_search_ranking_query"/>
        </foreign-key>

        <foreign-key name="spy_srqr-fk_product_abstract" foreignTable="spy_product_abstract" onDelete="CASCADE">
            <reference local="fk_product_abstract" foreign="id_product_abstract"/>
        </foreign-key>

        <unique name="unique-spy_srqr-query_customer_product">
            <unique-column name="fk_search_ranking_query"/>
            <unique-column name="customer_reference"/>
            <unique-column name="fk_product_abstract"/>
        </unique>

        <index name="index-spy_srqr-fk_product_abstract">
            <index-column name="fk_product_abstract"/>
        </index>

        <index name="index-spy_srqr-customer_reference">
            <index-column name="customer_reference"/>
        </index>
    </table>

</database>
