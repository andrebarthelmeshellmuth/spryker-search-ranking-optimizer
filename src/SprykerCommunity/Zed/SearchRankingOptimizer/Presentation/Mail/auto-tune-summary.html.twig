<p>
    The monthly search-ranking auto-tune check found {{ mail.autoTuneMetricResults | length }} metric(s) whose
    live formula no longer fits its data well enough:
</p>
<table cellpadding="6" cellspacing="0" border="1" style="border-collapse: collapse;">
    <thead>
        <tr>
            <th>Metric</th>
            <th>Before</th>
            <th>After{{ mail.autoTuneAnyApplied ? ' (applied)' : ' (proposed only)' }}</th>
        </tr>
    </thead>
    <tbody>
        {% for metricResult in mail.autoTuneMetricResults %}
            <tr>
                <td>{{ metricResult.metricName }}</td>
                {% if metricResult.errorMessage %}
                    <td colspan="2">FAILED to check — {{ metricResult.errorMessage }}</td>
                {% else %}
                    <td>
                        {{ metricResult.beforeFormula }}<br />
                        R² = {{ metricResult.beforeFitRSquared }}
                    </td>
                    <td>
                        {% if metricResult.wasSkippedNonDeterministic %}
                            (skipped — formula is non-deterministic, no refit possible)
                        {% else %}
                            {{ metricResult.afterFormula }}<br />
                            R² = {{ metricResult.afterFitRSquared }}
                            {{ metricResult.wasApplied ? ' — applied' : ' — proposed, not applied' }}
                        {% endif %}
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
    </tbody>
</table>
